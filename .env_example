PORT=3001
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=uth-scientific-lakehouse
MINIO_REGION=us-east-1

LANCEDB_PATH=../data/gold/lancedb
MINING_PATH=../data/gold/mining
MODEL_PATH=../model/qwen2.5-7b-instruct-q4_k_m.gguf
GPU_LAYERS=99
CONTEXT_SIZE=4096
DEFAULT_TOP_K=5
USE_AUTHORITY_BOOST=true

RETRIEVAL_MODE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scientific_papers_gold

RABBITMQ_URL=amqp://admin:password123@localhost:5672
RABBITMQ_QUEUE_INGEST=scientific_paper_ingest
RABBITMQ_QUEUE_EMBED=scientific_chunk_embed
